# Copy outside Git to the qualified VM's private runtime directory as secrets.env.
# Fill using secure local generation and masked administrator-password input.
# This template intentionally fails validation until every secret is supplied.
R1_HOST=sfd.example.invalid
R1_ORIGIN_PORT=18443
R1_PUBLIC_PORT_SUFFIX=
R1_PG_ADMIN=
R1_PG_APP=
R1_S3_ROOT_KEY=
R1_S3_ROOT_SECRET=
R1_S3_APP_KEY=
R1_S3_APP_SECRET=
R1_ADMIN_HASH=
R1_SESSION_SECRET=
R1_DOWNLOAD_SECRET=
# Keep both zero until capacity and isolated recovery gates pass.
R1_RESUMABLE_MAX_BYTES=0
R1_RESUMABLE_RESERVED_BYTES=0
# Optional schema15 revocable sharing. Keep false until independent tests and backup verification.
R1_MANAGED_LINKS_ENABLED=false
