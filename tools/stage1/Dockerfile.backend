FROM docker.io/library/golang@sha256:d1f3216ef30257c850cc136ba42a359ccd9d3e75f19b2c276e520c0b4ef327ce AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY web ./web
COPY native ./native
RUN apk add --no-cache build-base openssl-dev && mkdir /out && gcc -O2 -s -I./native -o /out/sfd-hash ./native/sfd_hash.c ./native/sfd_hash_cli.c -lcrypto && CGO_ENABLED=0 GOOS=linux go build -o /out/backend ./cmd/backend
FROM docker.io/library/alpine@sha256:c26612752c78b18faacd63c7d50f4592c2e7b0f25e0e20e82bd74e465c57ab0d
RUN apk add --no-cache postgresql16-client libcrypto3 ca-certificates 'zlib>=1.3.2-r1' 'musl>=1.2.6-r3' 'musl-utils>=1.2.6-r3'
WORKDIR /app
COPY --from=build /out/backend /app/backend
COPY --from=build /out/sfd-hash /app/sfd-hash
COPY --from=build /src/web /app/web
LABEL org.opencontainers.image.revision="61195434bee5f9221a6f55469c719cb360504ea9" sfd.stage1="64e8b793"
ENTRYPOINT ["/app/backend"]
