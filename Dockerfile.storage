# Build the archived official community sources at exact, verified revisions.
# This is a reproducible local-development/test dependency, not a supported-service claim.
FROM golang:1.26.9-alpine3.24 AS base
RUN apk add --no-cache git
FROM base AS minio-build
WORKDIR /src/minio
RUN git init . && git remote add origin https://github.com/minio/minio.git && \
    git fetch --depth 1 origin 7aac2a2c5b7c882e68c1ce017d8256be2feea27f && \
    git checkout --detach FETCH_HEAD && \
    test "$(git rev-parse HEAD)" = 7aac2a2c5b7c882e68c1ce017d8256be2feea27f
RUN CGO_ENABLED=0 go build -o /out/minio .
FROM base AS mc-build
WORKDIR /src/mc
RUN git init . && git remote add origin https://github.com/minio/mc.git && \
    git fetch --depth 1 origin 77f82e18b5401a65958f1619df6ebb994634bd88 && \
    git checkout --detach FETCH_HEAD && \
    test "$(git rev-parse HEAD)" = 77f82e18b5401a65958f1619df6ebb994634bd88
RUN CGO_ENABLED=0 go build -o /out/mc .

FROM alpine:3.24
RUN apk upgrade --no-cache && apk add --no-cache ca-certificates && adduser -D -u 10001 minio && \
    mkdir /data && chown minio:minio /data
COPY --from=minio-build /out/minio /usr/local/bin/minio
COPY --from=mc-build /out/mc /usr/local/bin/mc
COPY --from=minio-build /src/minio/LICENSE /licenses/minio-LICENSE
COPY --from=mc-build /src/mc/LICENSE /licenses/mc-LICENSE
USER minio
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9001"]
