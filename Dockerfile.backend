FROM golang:1.26.9-alpine3.24 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY web ./web
COPY native ./native
RUN apk add --no-cache build-base openssl-dev python3
RUN make -C native test && mkdir -p /out && cp native/sfd-hash /out/sfd-hash
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/backend ./cmd/backend

FROM alpine:3.24
WORKDIR /app
RUN apk upgrade --no-cache && apk add --no-cache libcrypto3 ca-certificates && adduser -D -u 10001 sfd
COPY --from=build /out/backend /app/backend
COPY --from=build /src/web /app/web
COPY --from=build /out/sfd-hash /app/sfd-hash
USER sfd
EXPOSE 8080
ENV SFD_ADDR=:8080
ENTRYPOINT ["/app/backend"]
